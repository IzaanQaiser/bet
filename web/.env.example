# registration-svc's Cloud Run URL (docs/design plan Phase 2) — no
# trailing slash. NEXT_PUBLIC_ so it's inlined into the static export at
# build time (there's no server here to read it from at request time).
# In CI this comes from the REGISTRATION_SVC_URL repo Actions variable
# (.github/workflows/web-deploy.yml) instead of this file.
NEXT_PUBLIC_REGISTRATION_SVC_URL=https://registration-svc-xxxxx-uc.a.run.app

# dashboard-svc's Cloud Run URL (docs/design plan Phase 5) — same
# reasoning as above. In CI: the DASHBOARD_SVC_URL repo Actions variable.
NEXT_PUBLIC_DASHBOARD_SVC_URL=https://dashboard-svc-xxxxx-uc.a.run.app
